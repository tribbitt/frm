{
  "name": "final_trm_a2tn",
  "model": {
    "K": 0,
    "pos_encoding": "trm1d"
  },
  "data": {
    "root": "data/built/a2tn",
    "tokens_per_step": 160000,
    "max_rows": 4096
  },
  "train": {
    "init_from": "runs/trm_v2/import_a2tn.pt",
    "init_mode": "continue",
    "lr": 5e-05,
    "warmup_steps": 1000,
    "budget_pflops": 50000.0,
    "max_hours": 70.5,
    "decay_frac": 0.15,
    "decay_to": 0.0,
    "eval_every_pflops": 2500.0,
    "compile": true
  },
  "eval": {
    "splits": [
      "dev",
      "dev_composite"
    ],
    "max_versions": 32,
    "rounds": 16,
    "cf_rows": 512
  }
}
